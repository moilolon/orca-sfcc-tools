{
  "name": "orca-sfcc-tools",
  "private": true,
  "description": "Development tooling only: Orca loads the plugin from source, with no build step.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "volta": { "node": "24.22.3" },
  "scripts": {
    "types": "orca plugin types .",
    "typecheck": "orca plugin types . && tsc -p . --noEmit",
    "test": "orca plugin test .",
    "check": "orca plugin check .",
    "validate": "orca plugin validate .",
    "manifest": "node scripts/build-manifest.ts",
    "dw-index": "node --import ./scripts/resolve-ts.ts scripts/generate-dw-index.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
