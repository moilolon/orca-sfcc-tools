{
  "manifestVersion": 2,
  "id": "sfcc-tools",
  "name": "SFCC Tools",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Salesforce Commerce Cloud work in Orca: ISML, cartridge upload, sandbox status and the new errors of its log, over the official b2c CLI.",
  "repository": "https://github.com/moilolon/orca-sfcc-tools",
  "author": {
    "name": "moilolon"
  },
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "The plugin name beside a panel with the sandbox status, the upload of each cartridge, the new errors of the log and a line of ISML"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "sfcc",
        "title": "SFCC",
        "icon": "cloud",
        "entry": "src/panel/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "b2cPath",
        "title": "b2c path",
        "description": "The b2c CLI to run: a name found on PATH, or the full path to it.",
        "type": "string",
        "default": "b2c",
        "placeholder": "b2c"
      },
      {
        "key": "configFile",
        "title": "Configuration file",
        "description": "A dw.json to read instead of the workspace's own. Empty: dw.json at the root of the workspace, or of the project's main checkout when a worktree has none. A relative path starts at the workspace.",
        "type": "string",
        "default": "",
        "placeholder": "dw.json"
      },
      {
        "key": "developmentSuffix",
        "title": "Development key suffix",
        "description": "Appended to each key of dw.json (hostname, client-id, ...) to find the development instance.",
        "type": "string",
        "default": "-dev"
      },
      {
        "key": "stagingSuffix",
        "title": "Staging key suffix",
        "description": "Appended to each key of dw.json (hostname, client-id, ...) to find the staging instance.",
        "type": "string",
        "default": "-stg"
      },
      {
        "key": "productionSuffix",
        "title": "Production key suffix",
        "description": "Appended to each key of dw.json (hostname, client-id, ...) to find the production instance.",
        "type": "string",
        "default": "-prd"
      },
      {
        "key": "cartridgePath",
        "title": "Analysis: cartridge path",
        "description": "The cartridge path the analysis uses for every storefront, first cartridge first, separated by colons. Empty: each site's path from the site archives of the checkout (sites/<site>/site.xml), else from the git ref below.",
        "type": "string",
        "default": "",
        "placeholder": "app_custom:app_storefront_base"
      },
      {
        "key": "metadataRef",
        "title": "Analysis: metadata git ref",
        "description": "A git ref (a branch or tag) whose site archives and metadata the analysis reads, without checking it out, when the checkout has none. Empty: not read.",
        "type": "string",
        "default": "",
        "placeholder": "origin/main"
      },
      {
        "key": "errorsInterval",
        "title": "Errors: read interval",
        "description": "Minutes between reads of the sandbox's log for new errors. 0 turns the timer off; the other environments are read only when asked.",
        "type": "number",
        "default": 0,
        "minimum": 0,
        "maximum": 1440
      },
      {
        "key": "errorsFilter",
        "title": "Errors: log files",
        "description": "The log file prefixes read for errors, separated by commas.",
        "type": "string",
        "default": "error,customerror",
        "placeholder": "error,customerror"
      },
      {
        "key": "codeVersionPrefix",
        "title": "Code version prefix",
        "description": "Put before the workspace name to make the code version each workspace uploads to (ws-checkout-fix). Letters, digits, - and _; empty means ws-. A workspace keeps the name it got first, and a new name never takes a version already on the sandbox.",
        "type": "string",
        "default": "ws-",
        "maxLength": 16,
        "placeholder": "ws-"
      }
    ],
    "commands": [
      {
        "id": "debugger.start",
        "title": "SFCC: Start debugging the sandbox"
      },
      {
        "id": "debugger.stop",
        "title": "SFCC: Stop debugging"
      },
      {
        "id": "debugger.continue",
        "title": "SFCC: Continue (debugger)"
      },
      {
        "id": "debugger.stepOver",
        "title": "SFCC: Step over (debugger)"
      },
      {
        "id": "debugger.stepIn",
        "title": "SFCC: Step in (debugger)"
      },
      {
        "id": "debugger.stepOut",
        "title": "SFCC: Step out (debugger)"
      },
      {
        "id": "editor.openInEditor",
        "title": "SFCC: Open in SFCC editor",
        "when": "workspace"
      },
      {
        "id": "sandbox.pick",
        "title": "SFCC: Upload from this workspace",
        "when": "workspace"
      },
      {
        "id": "sandbox.release",
        "title": "SFCC: Stop uploading"
      },
      {
        "id": "sandbox.deploy",
        "title": "SFCC: Deploy everything again"
      },
      {
        "id": "sandbox.reload",
        "title": "SFCC: Reload the code version"
      },
      {
        "id": "sandbox.refresh",
        "title": "SFCC: Refresh sandbox status"
      },
      {
        "id": "sandbox.start",
        "title": "SFCC: Start sandbox"
      },
      {
        "id": "sandbox.stop",
        "title": "SFCC: Stop sandbox"
      }
    ],
    "customEditors": [
      {
        "id": "sfcc",
        "title": "SFCC",
        "extensions": [
          ".isml"
        ],
        "priority": "default",
        "entry": "src/pieces/editor/main.ts",
        "frame": "isolated"
      },
      {
        "id": "sfcc-view",
        "title": "SFCC",
        "extensions": [
          ".js",
          ".xml",
          ".properties"
        ],
        "priority": "option",
        "entry": "src/pieces/editor/main.ts",
        "frame": "isolated"
      }
    ],
    "keybindings": [
      {
        "command": "editor.openInEditor",
        "key": "Alt+Shift+E",
        "when": "workspace"
      }
    ],
    "hooks": [
      {
        "event": "editor.save.before"
      }
    ],
    "statusBarItems": [
      {
        "id": "errors-new",
        "text": "0",
        "icon": "bug",
        "tone": "warning",
        "tooltip": "New errors on the sandbox"
      },
      {
        "id": "sandbox",
        "text": "Sandbox",
        "icon": "cloud",
        "tooltip": "Sandbox state. Press to refresh.",
        "command": "sandbox.refresh"
      },
      {
        "id": "sandbox-upload",
        "text": "Upload",
        "icon": "upload",
        "tooltip": "The upload to the sandbox.",
        "command": "sandbox.refresh"
      }
    ],
    "syntaxes": [
      {
        "id": "isml",
        "title": "ISML",
        "scopeName": "text.html.isml",
        "path": "src/pieces/isml/isml.tmLanguage.json",
        "configuration": "src/pieces/isml/language-configuration.json",
        "extensions": [
          ".isml"
        ]
      }
    ],
    "events": [
      {
        "on": "workspace.removed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
