{
  "contributes": {
    "commands": [
      { "id": "sandbox.pick", "title": "SFCC: Upload from this workspace", "when": "workspace" },
      { "id": "sandbox.release", "title": "SFCC: Stop uploading" },
      { "id": "sandbox.deploy", "title": "SFCC: Deploy everything again" },
      { "id": "sandbox.reload", "title": "SFCC: Reload the code version" },
      { "id": "sandbox.refresh", "title": "SFCC: Refresh sandbox status" },
      { "id": "sandbox.start", "title": "SFCC: Start sandbox" },
      { "id": "sandbox.stop", "title": "SFCC: Stop sandbox" }
    ],
    "events": [{ "on": "workspace.removed" }],
    "settings": [
      {
        "key": "codeVersionPrefix",
        "title": "Code version prefix",
        "description": "Put before the workspace name to make the code version each workspace uploads to (ws-checkout-fix). Letters, digits, - and _. A workspace keeps the name it got first.",
        "type": "string",
        "default": "ws-",
        "maxLength": 16,
        "placeholder": "ws-"
      }
    ],
    "statusBarItems": [
      { "id": "sandbox", "text": "Sandbox", "icon": "cloud", "tooltip": "Sandbox state. Press to refresh.", "command": "sandbox.refresh" },
      { "id": "sandbox-upload", "text": "Upload", "icon": "upload", "tooltip": "The upload to the sandbox.", "command": "sandbox.refresh" }
    ]
  }
}
