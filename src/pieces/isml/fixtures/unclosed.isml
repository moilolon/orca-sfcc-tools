<p>An expression left open at the end of the line ${pdict.product.name
<p class="next">The next line starts clean</p>
<span title="${'a string left open}">Text</span>
<span class="after-string">Still HTML</span>
<isif condition="${pdict.count == 1">One</isif>
<p class="after-condition">Still HTML</p>
<div data-x='${ {open: 1 '>Text</div>
<p class="after-braces">Still HTML</p>
<div data-x="${ {a: 1} ">Text</div>
<p class="next">t</p>
<isif condition="${pdict.a}">
    <span class="b">${pdict.b}</span>
</isif>
<a href="${url}">link</a>
<a title="${a" data-x="{}">x</a>
<a title="${cls" onclick="f({a: 1})">x</a>
<div data-y="${ {a: {b: 1}}.a }">Two levels</div>
