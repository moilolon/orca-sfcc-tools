<isdecorate template="common/layout/page">
    <isscript>
        var priceHelper = require('*/cartridge/scripts/helpers/priceHelper');
    </isscript>
    <h1>${pdict.product.name}</h1>
    <span class="label">${Resource.msg('label.price', 'product', null)}</span>
